# Google Cloud / Gemini
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# coordinator, planner, synthesizer
RESEARCH_MODEL=gemini-3.8-flash
# the four tool-calling researchers
RESEARCHER_MODEL=gemini-3.5-flash-lite

# Local notes / vector DB
# chroma (local, default) or rag_engine (Google-managed)
VECTOR_BACKEND=chroma
LOCAL_DOCS_DIR=/mnt/e/AI_ML/ML
CHROMA_DIR=~/.ml_researcher/chroma
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
EMBED_WORKERS=4
HYBRID_SEARCH=true
HNSW_EF_SEARCH=100
FILE_WORKERS = 3
CHECKPOINT_DB=~/.ml_researcher/checkpoints.sqlite

#logging
LOG_TO_GCP=true

# RAG Engine backend only (must be a region, not global)
RAG_LOCATION=europe-west4
RAG_CORPUS_NAME=ml-notes

# External APIs
GITHUB_TOKEN=
YOUTUBE_API_KEY=
# Cohere reranker (top RERANK_CANDIDATES fused hits -> top 5); without a key, search keeps the fused order
COHERE_API_KEY=
RERANK=true
RERANK_MODEL=rerank-v5.0-pro
RERANK_CANDIDATES=15

# Gemini request pacing (calls/second per process; 0 = unlimited)
GEMINI_RPS=5
BATCH_RPS=1

# Models: "provider:model" (google_genai | anthropic). A bare name means Gemini.
# MAIN_MODEL=google_genai:gemini-3.8-flash
# RESEARCHER_MODEL=google_genai:gemini-3.5-flash-lite
# JUDGE_MODEL=        (default: MAIN_MODEL)
# VISION_MODEL=       (default: RESEARCHER_MODEL)
# CODE_SANDBOX=auto   (auto | google_genai | anthropic | none)
# ANTHROPIC_API_KEY=  (only for anthropic: models)
